AArch64 file-ref-reload-nodep-field-dmb
"fget() nodep, the LL/SC path's ordering: a relaxed RMW followed by dmb ish (the ldxr/stlxr loop stands in as LDADD, herd7 does not finish with the exclusives), f_mode read through the nodep pointer"
{
0:X0=slot; 0:X1=fop; 0:X2=cnt; 0:X3=q;
1:X0=slot; 1:X2=cnt;
slot=fop; fop=1; q=0; cnt=0;
}
 P0                       | P1                       ;
 STR X3,[X0]              | LDR X4,[X0]              ;
 MOV W5,#-1               | EOR X10,X4,X4            ;
 LDADDAL W5,W6,[X2]       | ADD X11,X2,X10           ;
 CBNZ W6,Lout0            | MOV W5,#1                ;
 MOV W7,#-1               | LDADD W5,W6,[X11]        ;
 MOV W8,#-4               | DMB ISH                  ;
 CASL W7,W8,[X2]          | ADD W7,W6,W5             ;
 MOV W9,#-1               | CMP W7,#0                ;
 CMP W7,W9                | B.LT Lout1               ;
 B.NE Lout0               | LDR X8,[X0]              ;
 DMB ISHLD                | CMP X8,X4                ;
 STR WZR,[X2]             | B.NE Lout1               ;
 MOV W10,#2               | LDR W9,[X4]              ;
 STR W10,[X1]             | Lout1:                   ;
 STLR X1,[X0]             |                          ;
 Lout0:                   |                          ;
exists (0:X6=0 /\ 0:X7=-1 /\ 1:X4=fop /\ 1:X6=0 /\ 1:X8=fop /\ 1:X9=1)
