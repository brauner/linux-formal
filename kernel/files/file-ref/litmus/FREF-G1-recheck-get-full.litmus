C FREF-G1-recheck-get-full

(*
 * Expected: Never
 *
 * __fget_files_rcu() as it is: the fully ordered file_ref_get() between
 * the two loads of the slot.  Can the lookup pass its recheck with the
 * stale slot after taking its reference on the recycled file?
 *
 * P0 is the owner: close(fd) clears the slot (file_close_fd_locked():
 * rcu_assign_pointer(fdt->fd[fd], NULL), a plain WRITE_ONCE() for a
 * constant NULL), fput() drops the last reference (file_ref_put():
 * atomic_long_dec_return(), then __file_ref_put(): try_cmpxchg_release()
 * NOREF -> DEAD), __fput() frees the file, and open() gets the same
 * object back from the SLAB_TYPESAFE_BY_RCU cache: init_file() sets
 * f_ref to ONEREF (atomic_long_set(), a plain store), fd_install() puts
 * it into another slot (rcu_assign_pointer(), a release store).
 *
 * P1 is __fget_files_rcu(): rcu_read_lock(), file = *fdentry,
 * file_ref_get(), file != *fdentry.
 *
 * Encoding: the counter holds references - 1, ONEREF 0, NOREF -1, DEAD -4.
 * slot = 1 is the file, 0 NULL; slot2 is the other slot.  0:r1 = -1 says
 * the cmpxchg succeeded, so the file was freed and recycled, and the
 * only way for 1:r1 = 0 is then the recycled ONEREF.  Bad outcome: the
 * reference is on the recycled file and the recheck still read the old
 * slot, so the lookup returns a file the descriptor never named.
 *
 * Code (fs/file.c at v7.4-rc1-132-g05441d697f7f):
 *   1198   file_ref_get() gives us a full memory barrier. We
 *   1199   only really need an 'acquire' one to protect the
 *   1200   loads below, but we don't have that.
 *   1202   if (unlikely(!file_ref_get(&file->f_ref)))
 *   1218   if (unlikely(file != rcu_dereference_raw( *fdentry)) ||
 *)

{
	atomic_t cnt = ATOMIC_INIT(0);
	slot=1;
	slot2=0;
	0:r1=-9;
}

P0(int *slot, int *slot2, atomic_t *cnt)
{
	int r0;
	int r1;

	WRITE_ONCE(*slot, 0);
	r0 = atomic_fetch_sub(1, cnt);
	if (r0 == 0) {
		r1 = atomic_cmpxchg_release(cnt, -1, -4);
		if (r1 == -1) {
			atomic_set(cnt, 0);
			smp_store_release(slot2, 1);
		}
	}
}

P1(int *slot, atomic_t *cnt)
{
	int r0;
	int r1;
	int r2;

	rcu_read_lock();
	r0 = READ_ONCE(*slot);
	r1 = atomic_fetch_add(1, cnt);
	r2 = READ_ONCE(*slot);
	rcu_read_unlock();
}

exists (0:r1=-1 /\ 1:r0=1 /\ 1:r1=0 /\ 1:r2=1)
