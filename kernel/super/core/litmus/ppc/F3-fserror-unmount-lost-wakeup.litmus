PPC F3-fserror-unmount-lost-wakeup
(* LKMM result: Sometimes; hand translation of ../SUPER-F3-fserror-unmount-lost-wakeup.litmus.
   P0 fserror_pending_dec(): atomic_fetch_sub_release() = lwsync; lwarx/stwcx.
   (one attempt; a failed stwcx. just ends that execution's decrement, see the
   r1=1 condition), smp_acquire__after_ctrl_dep() = smp_rmb() = lwsync,
   waitqueue_active() = lwz.  P1: __add_wait_queue() stw, set_current_state()
   = stw; sync, re-check lwz. cnt=1: the unmount already dropped the bias. *)
{
cnt=1;
wq=0;
state=0;
0:r20=cnt; 0:r21=wq;
1:r20=cnt; 1:r21=wq; 1:r22=state;
}
 P0                 | P1              ;
 lwsync             | li r10,1        ;
 lwarx r1,r0,r20    | stw r10,0(r21)  ;
 addi r2,r1,-1      | li r11,2        ;
 stwcx. r2,r0,r20   | stw r11,0(r22)  ;
 bne Lfail          | sync            ;
 cmpwi r1,1         | lwz r3,0(r20)   ;
 bne Lout           |                 ;
 lwsync             |                 ;
 lwz r4,0(r21)      |                 ;
 b Lout             |                 ;
 Lfail:             |                 ;
 li r1,9            |                 ;
 Lout:              |                 ;
exists (0:r1=1 /\ 0:r4=0 /\ 1:r3=1)
