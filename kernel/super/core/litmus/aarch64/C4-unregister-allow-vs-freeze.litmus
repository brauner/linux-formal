AArch64 C4-unregister-allow-vs-freeze
(* LKMM result: Sometimes; hand translation of ../SUPER-C4-unregister-allow-vs-freeze.litmus.
   P0 btrfs_release_device_allow_freeze(): refcount_dec_and_test() =
   atomic_fetch_sub_release() (NEG + LDADDL) and, on success,
   smp_rmb() = DMB ISHLD plus the unlink; then bdev_allow_freeze():
   the WARN_ON_ONCE() load and atomic_inc() = STADD (relaxed LSE).
   P1 bdev_freeze(): atomic_inc_unless_negative() from 0 = fully ordered
   cmpxchg = CASAL; the lookup load; refcount_inc_not_zero() = relaxed
   cmpxchg = CAS.  bd_holder_lock is left out.  Under the Arm model the
   branch on the LDADDL result orders the later STADD (control
   dependencies to stores extend to everything after the branch), so the
   LKMM-only outcome is forbidden here. *)
{
count=-1;
sdref=1;
head=1;
0:X0=sdref; 0:X1=count; 0:X2=head;
1:X0=sdref; 1:X1=count; 1:X2=head;
}
 P0                  | P1                  ;
 MOV W9,#-1          | MOV W13,#0          ;
 LDADDL W9,W10,[X0]  | MOV W14,#1          ;
 CMP W10,#1          | CASAL W13,W14,[X1]  ;
 B.NE L0             | CMP W13,#0          ;
 DMB ISHLD           | B.NE L1             ;
 STLR WZR,[X2]       | LDR W17,[X2]        ;
 L0:                 | CMP W17,#1          ;
 LDR W11,[X1]        | B.NE L1             ;
 MOV W12,#1          | MOV W15,#1          ;
 STADD W12,[X1]      | MOV W16,#2          ;
                     | CAS W15,W16,[X0]    ;
                     | L1:                 ;
exists (1:X13=0 /\ 1:X17=1 /\ 1:X15=1)
