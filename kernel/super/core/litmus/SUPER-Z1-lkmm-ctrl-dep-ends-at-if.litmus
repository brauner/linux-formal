C SUPER-Z1-lkmm-ctrl-dep-ends-at-if

(*
 * Expected: Sometimes
 *
 * Reference test for the reasoning in SUPER-C4 (not kernel code): under
 * LKMM a control dependency orders only the stores inside the if
 * statement, not the stores after it (memory-barriers.txt, CONTROL
 * DEPENDENCIES: the compiler may hoist a store that both branches
 * reach).  LB with smp_mb() on one side and a store after the end of an
 * if on the other is allowed.  With the store inside the if it is
 * forbidden (tools/memory-model/litmus-tests/LB+fencembonceonce+ctrlonceonce.litmus).
 *)

{}

P0(int *x, int *y)
{
	int r0;
	int r9;

	r0 = READ_ONCE(*x);
	if (r0 == 1) {
		r9 = 1;
	}
	WRITE_ONCE(*y, 1);
}

P1(int *x, int *y)
{
	int r1;

	r1 = READ_ONCE(*y);
	smp_mb();
	WRITE_ONCE(*x, 1);
}

exists (0:r0=1 /\ 1:r1=1)
