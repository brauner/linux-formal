---------------------------- MODULE MC_dtblob ----------------------------
(* The layout for SuperDevHash: s1 on d1 and s2 on d2 both claim the blob d3 during the mount (erofs, refused -> the mount fails), both unmounted, s2's mount may fail; a freezer on d3. *)
(* Generated by gen-cfgs.py. *)
EXTENDS SuperDevHash, TLC

DevsDef == {"d1", "d2", "d3"}
SbsDef == {"s1", "s2"}
EmbOfDef == ("s1" :> 1) @@ ("s2" :> 2)
AllocDef == 3..6
CurOfDef == ("F3" :> 101)
FsCfgDef == ("s1" :> [main |-> "d1", xmode |-> "mount", xdev |-> "d3", onfail |-> "fail", dropx |-> "no", umount |-> TRUE, mayfail |-> FALSE]) @@ ("s2" :> [main |-> "d2", xmode |-> "mount", xdev |-> "d3", onfail |-> "fail", dropx |-> "no", umount |-> TRUE, mayfail |-> TRUE])
FreezersDef == ("F3" :> "d3")
CursorsDef == [x \in {} |-> "none"]
DupsDef == [x \in {} |-> [sb |-> "none", after |-> FALSE]]
