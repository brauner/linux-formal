ARM MNT-E1um-walker-nomb
(* LKMM result: Sometimes; translation of litmus/MNT-E1um-walker-nomb.litmus, see gen-asm.py for the barrier mapping *)
{
gets_u=1;
flags=1;
0:R0=seq;
0:R1=gets_w;
0:R2=mlock;
0:R3=flags;
0:R4=puts_w;
1:R0=mlock;
1:R1=seq;
1:R2=puts_u;
1:R3=puts_w;
1:R4=gets_w;
1:R5=gets_u;
