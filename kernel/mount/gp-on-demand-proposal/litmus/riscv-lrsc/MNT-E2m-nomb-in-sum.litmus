RISCV MNT-E2m-nomb-in-sum
(* LKMM result: Sometimes; translation of litmus/MNT-E2m-nomb-in-sum.litmus, see gen-asm.py for the barrier mapping *)
{
mnt_ns=1;
gets_u=1;
0:x10=seq;
0:x11=gets_w;
0:x12=mlock;
0:x13=flags;
0:x14=puts_w;
1:x10=mlock;
1:x11=seq;
1:x12=puts_w;
1:x13=puts_u;
1:x14=gets_w;
1:x15=gets_u;
1:x16=mnt_ns;
1:x17=flags;
1:x18=freed;
}
 P0                  | P1                  ;
 lw x20,0(x10)       | ori x9,x0,1         ;
 fence r,r           | lr.w x20,(x10)      ;
 fence r,r           | bne x20,x0,Lfail11  ;
 lw x21,0(x10)       | sc.w x9,x9,(x10)    ;
 bne x21,x0,Lend0    | bne x9,x0,Lfail11   ;
 ori x9,x0,1         | fence r,rw          ;
 sw x9,0(x11)        | j Lok11             ;
 fence rw,rw         | Lfail11:            ;
 fence r,r           | ori x20,x0,1        ;
 lw x22,0(x10)       | Lok11:              ;
 beq x22,x0,Lend0    | ori x9,x0,1         ;
 ori x9,x0,1         | sw x9,0(x11)        ;
 lr.w x23,(x12)      | fence w,w           ;
 bne x23,x0,Lfail01  | lw x21,0(x12)       ;
 sc.w x9,x9,(x12)    | lw x22,0(x13)       ;
 bne x9,x0,Lfail01   | lw x23,0(x14)       ;
 fence r,rw          | lw x24,0(x15)       ;
 j Lok01             | bne x23,x21,L11     ;
 Lfail01:            | sw x0,0(x16)        ;
 ori x23,x0,1        | ori x9,x0,1         ;
 Lok01:              | sw x9,0(x17)        ;
 lw x24,0(x13)       | ori x9,x0,1         ;
 beq x24,x0,Lskip0   | sw x9,0(x18)        ;
 ori x9,x0,1         | L11:                ;
 sw x9,0(x14)        | fence w,w           ;
 Lskip0:             | ori x9,x0,2         ;
 fence rw,w          | sw x9,0(x11)        ;
 sw x0,0(x12)        | fence rw,w          ;
 Lend0:              | sw x0,0(x10)        ;
filter (0:x23=0 /\ 1:x20=0 /\ 0:x20=0)
exists (0:x21=0 /\ 0:x22=0 /\ freed=1)
