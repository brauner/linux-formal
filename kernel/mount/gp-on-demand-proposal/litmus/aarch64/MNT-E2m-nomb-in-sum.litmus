}
 P0                | P1                ;
 LDR W10,[X0]      | MOV W9,#1         ;
 DMB ISHLD         | SWPA W9,W10,[X0]  ;
 DMB ISHLD         | MOV W9,#1         ;
 LDR W11,[X0]      | STR W9,[X1]       ;
 CBNZ W11,Lend0    | DMB ISHST         ;
 MOV W9,#1         | LDR W11,[X2]      ;
 STR W9,[X1]       | LDR W12,[X3]      ;
 DMB ISH           | LDR W13,[X4]      ;
 DMB ISHLD         | LDR W14,[X5]      ;
 LDR W12,[X0]      | CMP W13,W11       ;
 CBZ W12,Lend0     | B.NE L11          ;
 MOV W9,#1         | MOV W9,#0         ;
 SWPA W9,W13,[X2]  | STR W9,[X6]       ;
 LDR W14,[X3]      | MOV W9,#1         ;
 CBZ W14,Lskip0    | STR W9,[X7]       ;
 MOV W9,#1         | MOV W9,#1         ;
 STR W9,[X4]       | STR W9,[X8]       ;
 Lskip0:           | L11:              ;
 STLR WZR,[X2]     | DMB ISHST         ;
 Lend0:            | MOV W9,#2         ;
                   | STR W9,[X1]       ;
                   | STLR WZR,[X0]     ;
filter (0:X13=0 /\ 1:X10=0 /\ 0:X10=0)
exists (0:X11=0 /\ 0:X12=0 /\ freed=1)
