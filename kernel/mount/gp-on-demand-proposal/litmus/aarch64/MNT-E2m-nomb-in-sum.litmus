AArch64 MNT-E2m-nomb-in-sum
(* LKMM result: Sometimes; translation of litmus/MNT-E2m-nomb-in-sum.litmus, see gen-asm.py for the barrier mapping *)
{
mnt_ns=1;
gets_u=1;
0:X0=seq;
0:X1=gets_w;
0:X2=mlock;
0:X3=flags;
0:X4=puts_w;
1:X0=mlock;
1:X1=seq;
1:X2=puts_w;
1:X3=puts_u;
1:X4=gets_w;
1:X5=gets_u;
