RISCV MNT-E1um-nomb-in-sum
(* LKMM result: Sometimes; translation of litmus/MNT-E1um-nomb-in-sum.litmus, see gen-asm.py for the barrier mapping *)
{
gets_u=1;
flags=1;
0:x10=seq;
0:x11=gets_w;
0:x12=mlock;
0:x13=flags;
0:x14=puts_w;
1:x10=mlock;
1:x11=seq;
1:x12=puts_u;
1:x13=puts_w;
1:x14=gets_w;
1:x15=gets_u;
1:x16=flags;
1:x17=freed;
}
 P0                         | P1                         ;
 lw x20,0(x10)              | ori x9,x0,1                ;
 fence r,r                  | amoswap.w.aq x20,x9,(x10)  ;
 fence r,r                  | ori x9,x0,1                ;
 lw x21,0(x10)              | sw x9,0(x11)               ;
 bne x21,x0,Lend0           | fence w,w                  ;
 ori x9,x0,1                | ori x9,x0,1                ;
 sw x9,0(x11)               | sw x9,0(x12)               ;
 fence rw,rw                | lw x21,0(x13)              ;
 fence r,r                  | lw x22,0(x12)              ;
 lw x22,0(x10)              | lw x23,0(x14)              ;
 beq x22,x0,Lend0           | lw x24,0(x15)              ;
 ori x9,x0,1                | bne x23,x21,L11            ;
 amoswap.w.aq x23,x9,(x12)  | ori x9,x0,3                ;
 lw x24,0(x13)              | sw x9,0(x16)               ;
 beq x24,x0,Lskip0          | ori x9,x0,1                ;
 ori x9,x0,1                | sw x9,0(x17)               ;
 sw x9,0(x14)               | L11:                       ;
 Lskip0:                    | fence w,w                  ;
 fence rw,w                 | ori x9,x0,2                ;
 sw x0,0(x12)               | sw x9,0(x11)               ;
 Lend0:                     | fence rw,w                 ;
                            | sw x0,0(x10)               ;
filter (0:x23=0 /\ 1:x20=0 /\ 0:x20=0)
exists (0:x21=0 /\ 0:x22=0 /\ freed=1)
